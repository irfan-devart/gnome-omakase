#!/bin/bash

# Pick a theme from a rofi menu and apply it. A second press closes the menu.

set -euo pipefail

source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

pkill -x rofi && exit 0

current=$(cat "$OM_STATE/current" 2> /dev/null || true)
theme_args=()
[[ -f $OM_STATE/rofi.rasi ]] && theme_args=(-theme "$OM_STATE/rofi.rasi")

mkdir -p "$OM_STATE"
choice=$(om_theme_ids | rofi -x11 -normal-window -dpi 1 -dmenu -i -p "theme" \
  -select "$current" "${theme_args[@]}" 2>> "$OM_STATE/menu.log") || true
# rofi under XWayland can exit 1 even after a pick, so trust the output, not
# the exit code. Esc prints nothing; theme-set validates whatever comes back.
[[ -n $choice ]] || exit 0

"$OM_ROOT/bin/theme-set" "$choice" >> "$OM_STATE/menu.log" 2>&1
