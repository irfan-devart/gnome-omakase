#!/bin/bash

# List available themes; the current one is marked with *.

set -euo pipefail

source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

current=$(cat "$DK_STATE/current" 2> /dev/null || true)
while read -r id; do
  if [[ $id == "$current" ]]; then
    echo "* $id"
  else
    echo "  $id"
  fi
done < <(dk_theme_ids)
