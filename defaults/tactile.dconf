# Tactile grids. Load with: dconf load /org/gnome/shell/extensions/tactile/ < tactile.dconf
# Layout 1 (laptop screen): 2x2, keys Q W / A S.
# Layout 2 (external screen): 4x2, keys Q W E R / A S D F.
# Switch layout while the grid is showing: press 1 or 2.
# gap-size: pixels between tiled windows.
[/]
gap-size=4
col-0=1
col-1=1
col-2=0
col-3=0
row-0=1
row-1=1
row-2=0
layout-2-col-0=1
layout-2-col-1=1
layout-2-col-2=1
layout-2-col-3=1
layout-2-row-0=1
layout-2-row-1=1
layout-2-row-2=0
monitor-0-layout=1
monitor-1-layout=2
